<?php
$title = 'Contacto';
$this->headTitle($title);
?>

<?php if (!empty($this->saved)): ?>
    <div class="alert alert-success" role="alert">
        Tu mensaje se ha guardado correctamente.
    </div>
<?php else: ?>

<div class="row justify-content-center my-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white text-center py-3">
                <h2 class="h4 mb-0"><i class="bi bi-envelope-fill me-2"></i>Formulario de Contacto</h2>
            </div>
            <div class="card-body p-4">
                <p class="text-muted text-center mb-4">
                    ¿Tienes alguna duda o sugerencia? Déjanos tu mensaje y te responderemos a la brevedad.
                </p>

                <?php
                $form = $this->form;
                $form->setAttribute('action', $this->url('home'));
                $form->prepare();

                echo $this->form()->openTag($form);
                ?>

                <!-- Campo Nombre -->
                <div class="mb-3">
                    <?= $this->formLabel($form->get('nombre')->setLabelAttributes(['class' => 'form-label fw-bold'])) ?>
                    <?= $this->formElement($form->get('nombre')) ?>
                    <div class="text-danger small mt-1">
                        <?= $this->formElementErrors()->render($form->get('nombre')) ?>
                    </div>
                </div>

                <!-- Campo Email -->
                <div class="mb-3">
                    <?= $this->formLabel($form->get('email')->setLabelAttributes(['class' => 'form-label fw-bold'])) ?>
                    <?= $this->formElement($form->get('email')) ?>
                    <div class="text-danger small mt-1">
                        <?= $this->formElementErrors()->render($form->get('email')) ?>
                    </div>
                </div>

                <!-- Campo Mensaje -->
                <div class="mb-4">
                    <?= $this->formLabel($form->get('mensaje')->setLabelAttributes(['class' => 'form-label fw-bold'])) ?>
                    <?= $this->formElement($form->get('mensaje')) ?>
                    <div class="text-danger small mt-1">
                        <?= $this->formElementErrors()->render($form->get('mensaje')) ?>
                    </div>
                </div>

                <!-- Botón de Envío -->
                <div class="d-grid">
                    <?= $this->formSubmit($form->get('submit')->setAttribute('class', 'btn btn-primary btn-lg')) ?>
                </div>

                <?php echo $this->form()->closeTag(); ?>
            </div>
        </div>
    </div>
</div>
<?php endif; ?>